  "type": "module",
  "description": "Scalable MERN Starter Backend with TypeScript, Express, and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
